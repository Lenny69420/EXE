<!-- product-main-area-start -->
<div class="product-main-area mb-70">
    <div class="container-fluid">
        <div class="container">
            <div class="row">
                <div class="row">
                    @foreach (var item in ViewBag.Blogs)
                    {
                        <div class="col-lg-12">
                            <div class="row news-lg mx-0 mb-3">
                                <div class="col-md-3 h-100 px-0">
                                    @if (item.Image != null && item.Image.Length > 0)
                                    {
                                        var base64String = Convert.ToBase64String(item.Image);
                                        var imageSrc = $"data:image/jpeg;base64,{base64String}";
                                        <img class="img-fluid" src="@imageSrc" alt="@item.Title" style="object-fit: cover; width: 300px; height: 198px;">
                                    }
                                    else
                                    {
                                        <img class="img-fluid" src="~/img/blog/placeholder.png" alt="@item.Title" style="object-fit: cover; width: 300px; height: 198px;">
                                    }


                                </div>
                                <div class="col-md-9 d-flex flex-column border bg-white h-100 px-0">
                                    <div class="mt-auto p-4">
                                        <div class="mb-2">

                                            @*  <a class="badge badge-primary text-uppercase font-weight-semi-bold p-2 mr-2"
                                               href=""><span class='badge bg-primary'>@item.Title</span></a> *@

                                            <small class="text-body badge bg-warning" style="margin-left:10px">24-05-2025</small>
                                        </div>
                                        @*   <a class="h4 d-block mb-3 text-secondary text-uppercase font-weight-bold ellipsis" asp-controller="NewsArticle"
                                           asp-route-id="@item.NewsArticleId" asp-action="Details">@item.NewsTitle</a> *@

                                        <a class="h4 d-block mb-3 text-secondary text-uppercase font-weight-bold ellipsis"
                                           asp-controller="Blog" asp-route-id="@item.Id" asp-action="BlogDetail">@item.Title</a>

                                        <p class="m-0 ellipsis">

                                        </p>
                                    </div>
                                    <div class="d-flex justify-content-between bg-white border-top mt-auto p-4">
                                        <div class="d-flex align-items-center">
                                            <img class="rounded-circle mr-2"
                                                 src="~/img/logo/airtentive.jpg"
                                                 width="25" height="25" alt="">
                                            <small style="margin-left:10px">  Đăng lên bởi Airtentive</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @* <div class="mt-3"> *@
                @*     <h6>Page @Model.PageIndex  out of @Model.TotalPages</h6> *@
                @*     <nav> *@
                @*         <ul class="pagination"> *@
                @*             <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")"> *@
                @*                 <a class="page-link" href="?pageIndex=@(Model.PageIndex - 1)&title=@Model.SearchQuery">Previous</a> *@
                @*             </li> *@
                @*             <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")"> *@
                @*                 <a class="page-link" href="?pageIndex=@(Model.PageIndex + 1)&title=@Model.SearchQuery">Next</a> *@
                @*             </li> *@
                @*         </ul> *@
                @*     </nav> *@
                @* </div> *@
            </div>
        </div>
    </div>
</div>