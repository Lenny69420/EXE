@model QuatBook.Models.Order

<div class="container">
    <h4 class="text-primary mb-3">Order #@Model.OrderId</h4>
    <div class="row">
        <div class="col-md-6">
            <p><strong>Tên khách hàng:</strong> @(Model.Account?.Username ?? "N/A")</p>
            <p><strong>Địa chỉ:</strong> @(Model.Address ?? "N/A")</p>
            <p><strong>Tổng số lượng:</strong> @Model.Ammount?.ToString("C")</p>
            <p>
                <strong>Phương pháp thanh toán:</strong>
                <span class="badge @(Model.PaymentMethod == "VNPAY" ? "bg-success" : "bg-warning")">
                    @Model.PaymentMethod
                </span>
            </p>
        </div>
        <div class="col-md-6">
            <p>
                <strong>Trạng thái:</strong>
                <span class="badge @(Model.Status == "Paid" ? "bg-success" : Model.Status == "Pending" ? "bg-warning" : "bg-danger")">
                    @Model.Status
                </span>
            </p>
            <p><strong>Tạo lúc:</strong> @Model.CreateTime?.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Số điện thoại:</strong> @Model.Phone?</p>
        </div>
    </div>

    <h5 class="mt-4">Danh sách sản phẩm</h5>
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Sản Phẩm</th>
                    <th>Số lượng</th>
                    <th>Giá </th>
                    <th>Tổng giá</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.OrderDetails)
                {
                    <tr>
                        <td>
                            @if (detail.Product?.Image != null && detail.Product.Image.Length > 0)
                            {
                                var base64String = Convert.ToBase64String(detail.Product.Image);
                                var imageSrc = $"data:image/jpeg;base64,{base64String}";
                                <img src="@imageSrc" alt="@detail.Product.BookName" style="width: 50px; height: 50px; object-fit: cover;" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>
                        <td>@(detail.Product?.BookName ?? "N/A")</td>
                        <td>@detail.Quantity</td>
                        <td>@detail.Product?.Price?.ToString("C")</td>
                        <td>@((detail.Product?.Price * detail.Quantity)?.ToString("C"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>